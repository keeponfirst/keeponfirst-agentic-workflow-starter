# 環境變數（絕對不要 commit）
.env
.env.local
.env.*.local

# MCP 設定（包含 Project ID）
.mcp.json

# Claude Code 本地設定
.claude/

# Nano Banana 輸出（測試用）
nanobanana-output/

# Stitch MCP Server（獨立 repo: github:keeponfirst/kof-stitch-mcp）
stitch/mcp-server/

# Nano Banana MCP Server（獨立 package: @keeponfirst/kof-nanobanana-mcp）
kof-nanobanana-mcp/

# Pencil 專案檔案
*.pen

# Stitch tools dump（自動產生）
stitch_tools.json

# Scripts 的 node_modules
scripts/node_modules/
scripts/package-lock.json

# 產出檔案（依專案需求決定是否 commit）
assets/generated/*
!assets/generated/.gitkeep

# 任務佇列（通常不需要 commit）
# nanobanana/queue/*
!nanobanana/queue/.gitkeep
# jules/tasks/*
!jules/tasks/.gitkeep

# 執行產出
# PLAN.md

# OS 檔案
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node（如果有使用）
node_modules/
npm-debug.log

# Python（如果有使用）
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log
